  <script type="text/plain" id="src-3">

// ============ الخلية 3: منطق اللعبة ============

// الحالة: الجولة، النقاط، السلسلة، والمرحلة (q سؤال، r نتيجة، end نهاية)

var G = {};



// خلط عشوائي (Fisher-Yates)

function shuffle(arr) {

  var a = arr.slice();

  // لوب for من النهاية: يبدل كل عنصر بعنصر عشوائي قبله

  for (var i = a.length - 1; i > 0; i--) {

    var j = Math.floor(Math.random() * (i + 1));

    var t = a[i]; a[i] = a[j]; a[j] = t;

  }

  return a;

}



// بداية لعبة جديدة

function startGame() {

  G = { round: 0, total: PUZZLES.length, score: 0, ai: 0, streak: 0, order: shuffle(PUZZLES), phase: "q", current: null, last: null, taught: false };

  G.current = G.order[0];

  renderPanel();

}



// اختيار اللاعب: نحسب نقاطه ونقاط النموذج

function guess(label) {

  if (G.phase !== "q") return;

  var correct = label === G.current[1];

  // شرط: النقاط تزيد مع السلسلة الصحيحة، والسلسلة تنكسر عند الغلط

  if (correct) { G.streak++; G.score += 10 + (G.streak - 1) * 2; } else { G.streak = 0; }

  var a = analyze(G.current[0]);

  // النموذج يكسب إذا توقع الصح بثقة

  var aiOk = !a.uncertain && a.label === G.current[1];

  if (aiOk) G.ai += 10;

  G.last = { guess: label, correct: correct, ai: a, aiOk: aiOk, gained: correct ? 10 + (G.streak - 1) * 2 : 0 };

  G.phase = "r";

  renderPanel();

}



// تعليم النموذج: نضيف الجملة بالإجابة الصح ونعيد التدريب

function teach() {

  if (G.taught) return;

  DATA.push([G.current[0], G.current[1]]);

  MODEL = trainNB(DATA);

  G.taught = true;

  renderPanel();

}



// الجولة التالية أو النهاية

function next() {

  G.round++;

  if (G.round >= G.total) { G.phase = "end"; }

  else { G.phase = "q"; G.current = G.order[G.round]; G.last = null; G.taught = false; }

  renderPanel();

}



// رسم اللوحة كاملة حسب المرحلة

function renderPanel() {

  var shown = Math.min(G.round + 1, G.total);

  var board = '<div class="board"><div>نقاطك<b>' + G.score + '</b></div><div>نقاط النموذج<b>' + G.ai + '</b></div><div>الجولة<b>' + shown + '/' + G.total + '</b></div></div>';

  var body = "";

  if (G.phase === "end") {

    var verdict = G.score > G.ai ? "فزت على النموذج!" : G.score < G.ai ? "النموذج فاز هذي المرة." : "تعادلتم!";

    body = '<p><b>انتهت اللعبة</b></p><p>' + verdict + '</p><div class="row"><button class="btn primary" onclick="startGame()">العب مرة ثانية</button></div>';

  } else if (G.phase === "q") {

    var buttons = CHOICES.map(function (c) { return '<button class="btn" onclick="guess(\'' + c + '\')">' + LABEL_AR[c] + '</button>'; }).join("");

    body = '<div class="quote">"' + G.current[0] + '"</div><p>وش الشخصية؟</p><div class="choices">' + buttons + '</div>';

  } else {

    var L = G.last, aiText = L.ai.uncertain

      ? "النموذج قال: غير واضح (ثقة " + Math.round(L.ai.prob * 100) + "%)"

      : "النموذج توقع: " + LABEL_AR[L.ai.label] + " (ثقة " + Math.round(L.ai.prob * 100) + "%)";

    var msg = L.correct ? '<span class="ok">إجابتك صح! +' + L.gained + ' نقطة</span>'

                        : '<span class="bad">إجابتك غلط. الصح: ' + LABEL_AR[G.current[1]] + '</span>';

    var teachBtn = (!L.aiOk && !G.taught) ? '<button class="btn" onclick="teach()">علّم النموذج الإجابة الصح</button>' : "";

    var note = G.taught ? '<p class="ok">تم، النموذج تعلّم من هذي الجملة.</p>' : "";

    body = '<div class="quote">"' + G.current[0] + '"</div><div class="result">' + msg + '<br>' + aiText + '</div>' + note +

           '<div class="row">' + teachBtn + '<button class="btn primary" onclick="next()">' + (G.round + 1 >= G.total ? "شوف النتيجة" : "الجولة التالية") + '</button></div>';

  }

  document.getElementById("game").innerHTML = board + body;

}



// الجزء الظاهر: نرسم حاوية اللعبة داخل مخرجات الخلية ونبدأ

render('<div id="game"></div>');

startGame();

  </script>



