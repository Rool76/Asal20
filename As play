  <script type="text/plain" id="src-4">

// ============ الخلية 4: اكتب شخصية وحللها ============



// تحليل الشخصية اللي كتبها المستخدم وعرض النسب

function analyzeInput() {

  var text = document.getElementById("ci").value.trim();

  if (!text) { alert("اكتب شي أولاً"); return; }

  var a = analyze(text);

  var bars = MODEL.classes.map(function (c) {

    var pct = Math.round(a.probs[c] * 100);

    return '<div class="bar"><span>' + LABEL_AR[c] + ' ' + pct + '%</span><div class="track"><div class="fill" style="width:' + pct + '%"></div></div></div>';

  }).join("");

  var verdict = a.uncertain ? "غير واضح (ثقة " + Math.round(a.prob * 100) + "%)" : LABEL_AR[a.label] + " (ثقة " + Math.round(a.prob * 100) + "%)";

  document.getElementById("ci-out").innerHTML = '<p><b>التحليل:</b> ' + verdict + '</p>' + bars;

  // نحدد التصنيف المتوقع في القائمة تلقائياً

  document.getElementById("ci-label").value = a.label;

}



// إضافة الشخصية للتدريب بالتصنيف اللي يختاره المستخدم

function addCharacter() {

  var text = document.getElementById("ci").value.trim();

  var label = document.getElementById("ci-label").value;

  if (!text) { alert("اكتب شي أولاً"); return; }

  DATA.push([text, label]);

  MODEL = trainNB(DATA);

  document.getElementById("ci-msg").textContent = "تمت الإضافة للتدريب، عدد الأمثلة الحين: " + DATA.length;

}



// نرسم نموذج الكتابة

var opts = Object.keys(LABEL_AR).map(function (c) { return '<option value="' + c + '">' + LABEL_AR[c] + '</option>'; }).join("");

render('<div class="form-cell">' +

  '<label for="ci">اكتب كلام الشخصية وتصرفاتها</label>' +

  '<textarea id="ci" placeholder="مثال: ما يتأخر عن أي مساعدة، يرد على الكل بأي وقت"></textarea>' +

  '<div class="row"><button class="btn primary" onclick="analyzeInput()">حلّل</button>' +

  '<select id="ci-label">' + opts + '</select>' +

  '<button class="btn" onclick="addCharacter()">أضفها للتدريب</button></div>' +

  '<div id="ci-out" style="margin-top:10px"></div><p id="ci-msg" class="ok"></p></div>');

document.getElementById("stat").textContent = "أمثلة التدريب: " + DATA.length;

  </script>



  <!-- المرحلة الثالثة: درّب نموذجك بنفسك -->

  <section style="margin-top:28px">

    <h2 style="font-size:18px;margin:0 0 4px">المرحلة الثالثة: درّب نموذجك بنفسك</h2>

    <p style="font-size:14px;color:#5f6368;margin:0 0 6px;line-height:1.8">انسخ كل كود وألصقه في المربع، ثم اضغط شغّل. الصفحة تتأكد إن الكود يستدعي الدالة الصحيحة وتعرض الناتج تحته.</p>

    <div class="tprog"><div id="tbar"></div></div>

    <div id="tsteps"></div>

  </section>



</main>



<script>

  // محرك التشغيل: يعرض كود كل خلية ويشغّله من نفس المصدر

  function render(html) {

    if (window.__out) window.__out.insertAdjacentHTML("beforeend", html);

  }

  function runCell(srcId) {

    var code = document.getElementById(srcId).textContent;

    var out = document.querySelector('[data-out="' + srcId + '"]');

    window.__out = out;

    out.innerHTML = "";

    try {

      (0, eval)(code);

    } catch (e) {

      out.innerHTML = '<span class="err">خطأ: ' + e.message + '</span>';

    }

  }

  document.querySelectorAll(".run").forEach(function (btn) {

    btn.addEventListener("click", function () { runCell(btn.getAttribute("data-run")); });

  });

  document.querySelectorAll('script[type="text/plain"]').forEach(function (s) {

    var show = document.querySelector('[data-show="' + s.id + '"]');

    if (show) show.textContent = s.textContent.replace(/^\n/, "").replace(/\s+$/, "");

  });

  ["src-1", "src-2", "src-3", "src-4"].forEach(runCell);

</script>

<script>

// ============ المرحلة الثالثة: خطوات التدريب (محاكاة تعليمية) ============

// pattern: يتأكد إن الكود فيه الاستدعاء الصحيح، و output: ناتج مسجّل مسبقاً (أمثلة توضيحية)

var TSTEPS = [

  { title: "الخطوة 1: استدعِ المكتبة", text: "المكتبة اسمها nbtools، استدعيها باسم nb.", hint: "import nbtools as nb\nprint(len(nb.DATA))", pattern: /import\s+nbtools\s+as\s+nb/, output: "60" },

  { title: "الخطوة 2: أضف بيانات كثيرة", text: "ضيف 30 مثال جديد لبيانات التدريب، عشان النموذج يتعلم من أمثلة أكثر.", hint: "more = [\n    (\"يركض لين يوصل للنار ويطلع الناس\", \"brave\"),\n    (\"ما يرجع ورا أي تحدي\", \"brave\"),\n    (\"أول واحد ينزل البحر بالليل\", \"brave\"),\n    (\"يوقف المشكلة قبل ما تكبر\", \"brave\"),\n    (\"يسوي وجه يضحك الكل بدون كلام\", \"comic\"),\n    (\"يقلد الكل وكل الجلسة تضحك\", \"comic\"),\n    (\"ترسل ميمز تخليك تموت من الضحك\", \"comic\"),\n    (\"كل كلمة منه تطلع ضحكة\", \"comic\"),\n    (\"يجلس قدام الشباك ويسمع المطر\", \"sad\"),\n    (\"ما عنده رغبة يطلع من البيت\", \"sad\"),\n    (\"كلامه كله عن الفراق والوحدة\", \"sad\"),\n    (\"يسكت وعيونه حمراء من البكاء\", \"sad\"),\n    (\"يتخيل كل السيناريوهات الخايبة\", \"worry\"),\n    (\"ما يقدر يوقف التفكير بالمستقبل\", \"worry\"),\n    (\"وش لو الرحلة ما صارت؟\", \"worry\"),\n    (\"يفكر بالأسوأ قبل ما يصير شي\", \"worry\"),\n    (\"أي وقت تحتاجه أنا موجود\", \"kafu\"),\n    (\"يرد على الرسالة بسرعة ويساعد\", \"kafu\"),\n    (\"يوصّل الناس للمستشفى بليل\", \"kafu\"),\n    (\"يستقبل الكل ويساعدهم بكل شي\", \"kafu\"),\n    (\"وش رأيك نطلع للغداء؟\", \"neutral\"),\n    (\"الكتاب على الطاولة\", \"neutral\"),\n    (\"أبغى أغير الكرسي\", \"neutral\"),\n    (\"الجوال فاضي من البطارية\", \"neutral\"),\n]\nnb.DATA.extend(more)\nprint(len(nb.DATA))", pattern: /nb\.DATA\s*(\+=|\.extend\()/, output: "تمت إضافة 30 مثال. المجموع الحين: 90" },

  { title: "الخطوة 3: تنظيف النص", text: "استدعِ nb.normalize على جملة فيها همزة وتشكيل.", hint: 'print(nb.normalize("أهلاً، الشِّي"))', pattern: /nb\.normalize\(/, output: "اهلا  الشي" },

  { title: "الخطوة 4: تقطيع النص لميزات", text: "استدعِ nb.tokenize على جملة، وشوف الميزات اللي يطلعها.", hint: 'print(nb.tokenize("ما عليك"))', pattern: /nb\.tokenize\(/, output: "['ما', 'عليك', 'ما_عليك']" },

  { title: "الخطوة 5: التدريب", text: "درّب النموذج على كل البيانات، وخزّنه في model.", hint: 'model = nb.train(nb.DATA)\nprint(model["classes"])', pattern: /model\s*=\s*nb\.train\(/, output: "['brave', 'comic', 'sad', 'worry', 'kafu', 'neutral']" },

  { title: "الخطوة 6: التوقع", text: "جرّب النموذج على جملة جديدة. predict ترجع نسبة كل تصنيف.", hint: 'print(nb.predict(model, nb.tokenize("تخيل لو ما نجحت")))', pattern: /nb\.predict\(\s*model/, output: "{'brave': 0.02, 'comic': 0.01, 'sad': 0.03, 'worry': 0.91, 'kafu': 0.02, 'neutral': 0.01}" },

  { title: "الخطوة 7: تقسيم 80/20", text: "قسّم البيانات: 80% للتدريب و20% للاختبار.", hint: 'sp = nb.split(nb.DATA, 0.8)\nprint({"train": len(sp["train"]), "test": len(sp["test"])})', pattern: /nb\.split\(/, output: "{'train': 72, 'test': 18}" },

  { title: "الخطوة 8: قياس الدقة", text: "درّب على جزء التدريب فقط، وقيّس الدقة على جزء الاختبار.", hint: 'sp = nb.split(nb.DATA, 0.8)\nm = nb.train(sp["train"])\nprint(nb.accuracy(m, sp["test"]))', pattern: /nb\.accuracy\(/, output: "0.83 (مثال توضيحي)" },

  { title: "الخطوة 9: جرّبه بنفسك", text: "غيّر الجملة لأي جملة تبيها، وشوف النموذج وش يتوقع.", hint: 'print(nb.argmax(nb.predict(model, nb.tokenize("اكتب جملتك هنا"))))', pattern: /nb\.argmax\(/, output: "worry (مثال توضيحي)" }

];



var tPassed = [];



// بناء خلايا المرحلة الثالثة

function tBuild() {

  document.getElementById("tsteps").innerHTML = TSTEPS.map(function (s, i) {

    return '<div class="tcell locked" id="t-cell-' + i + '">' +

      '<h3>' + s.title + ' <span class="tbadge" id="t-badge-' + i + '">مقفلة</span></h3>' +

      '<p>' + s.text + '</p>' +

      '<div class="row"><button class="btn" onclick="tHint(' + i + ')">زر المساعدة</button></div>' +

      '<div class="thint" id="t-hint-' + i + '">' + tEscape(s.hint) + '</div>' +

      '<div class="row"><button class="btn" onclick="tPaste(' + i + ')">حطه في المربع</button></div>' +

      '<textarea id="t-code-' + i + '" placeholder="الصق الكود هنا"></textarea>' +

      '<div class="row"><button class="btn primary" onclick="tRun(' + i + ')">شغّل</button></div>' +

      '<div class="msg" id="t-msg-' + i + '"></div>' +

      '<div class="tout" id="t-out-' + i + '"></div></div>';

  }).join("");

  tUnlock(0);

}



function tEscape(s) {

  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

}



// فتح خلية

function tUnlock(i) {

  var el = document.getElementById("t-cell-" + i);

  if (el) el.classList.remove("locked");

  document.getElementById("t-badge-" + i).textContent = "جاهزة";

}



function tHint(i) {

  document.getElementById("t-hint-" + i).classList.toggle("show");

}



function tPaste(i) {

  document.getElementById("t-code-" + i).value = TSTEPS[i].hint;

}



// التحقق من الكود ثم عرض الناتج المسجّل

function tRun(i) {

  var code = document.getElementById("t-code-" + i).value;

  var msg = document.getElementById("t-msg-" + i);

  var out = document.getElementById("t-out-" + i);

  if (!TSTEPS[i].pattern.test(code)) {

    msg.innerHTML = '<span class="bad">ما لقيت الاستدعاء الصحيح في الكود. راجع اسم الدالة، أو اضغط زر المساعدة.</span>';

    out.classList.remove("show");

    return;

  }

  msg.innerHTML = '<span class="ok">تمام، الكود صح.</span>';

  out.textContent = TSTEPS[i].output;

  out.classList.add("show");

  tFinish(i);

}



function tFinish(i) {

  if (tPassed.indexOf(i) === -1) tPassed.push(i);

  document.getElementById("t-cell-" + i).classList.add("done");

  document.getElementById("t-badge-" + i).textContent = "✓ مكتملة";

  document.getElementById("tbar").style.width = Math.round(tPassed.length / TSTEPS.length * 100) + "%";

  if (i + 1 < TSTEPS.length) tUnlock(i + 1);

  else document.getElementById("t-msg-" + i).innerHTML += '<p class="ok" style="margin-top:8px">خلّصت المرحلة الثالثة! درّبت النموذج وجربته بنفسك.</p>';

}



tBuild();

</script>

