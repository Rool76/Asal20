  <script type="text/plain" id="src-2">

// ============ الخلية 2: Multinomial Naive Bayes ============



// تنظيف النص العربي: حذف التشكيل، توحيد الأحرف، وإزالة علامات الترقيم

function normalize(text) {

  return text.replace(/[\u064B-\u0652]/g, "").replace(/[أإآ]/g, "ا").replace(/ة/g, "ه").replace(/ى/g, "ي")

    .replace(/[\u060C\u061B\u061F.,!?…"'()\-]/g, " ").toLowerCase().trim();

}



// تحويل النص لميزات: كلمات مفردة + كلمتين متتاليتين، والإيموجي كل واحد لحاله

function tokenize(text) {

  var spaced = normalize(text).replace(/([\u{1F300}-\u{1FAFF}\u2600-\u27BF])/gu, " $1 ");

  var words = spaced.split(/\s+/).filter(function (w) { return w.length > 0; });

  var tokens = words.slice();

  // لوب for: يبني الكلمتين المتتاليتين

  for (var i = 0; i < words.length - 1; i++) tokens.push(words[i] + "_" + words[i + 1]);

  return tokens;

}



// تدريب النموذج: نعد كل ميزة لكل تصنيف ونعد عدد الأمثلة لكل تصنيف

function trainNB(data) {

  var m = { classes: [], docCount: {}, wordCount: {}, totalWords: {}, vocab: {}, N: data.length };

  // لوب forEach: يمر على كل مثال

  data.forEach(function (row) {

    var label = row[1];

    // شرط: أول مرة نشوف التصنيف نجهز له جداول العد

    if (!m.wordCount[label]) { m.wordCount[label] = {}; m.totalWords[label] = 0; m.docCount[label] = 0; m.classes.push(label); }

    m.docCount[label]++;

    tokenize(row[0]).forEach(function (t) {

      m.vocab[t] = true;

      m.wordCount[label][t] = (m.wordCount[label][t] || 0) + 1;

      m.totalWords[label]++;

    });

  });

  m.V = Object.keys(m.vocab).length;

  return m;

}



// لوغاريتم احتمال ميزة داخل تصنيف مع Laplace smoothing (ما يصير الاحتمال صفر)

function logP(m, label, t) {

  return Math.log(((m.wordCount[label][t] || 0) + 1) / (m.totalWords[label] + m.V));

}



// حساب احتمال كل تصنيف: نجمع اللوغاريتمات ثم softmax لتحويلها لنسب

function predictNB(m, tokens) {

  var scores = {};

  m.classes.forEach(function (c) {

    var s = Math.log(m.docCount[c] / m.N);

    // شرط: نتجاهل الميزات اللي ما شافها النموذج

    tokens.forEach(function (t) { if (m.vocab[t]) s += logP(m, c, t); });

    scores[c] = s;

  });

  var max = Math.max.apply(null, m.classes.map(function (c) { return scores[c]; }));

  var sum = 0, probs = {};

  m.classes.forEach(function (c) { probs[c] = Math.exp(scores[c] - max); sum += probs[c]; });

  m.classes.forEach(function (c) { probs[c] /= sum; });

  return probs;

}



// التصنيف صاحب أعلى احتمال

function argmax(probs) {

  return Object.keys(probs).reduce(function (a, b) { return probs[b] > probs[a] ? b : a; });

}



// تحليل نص: إذا أعلى احتمال أقل من الحد نقول "غير واضح"

function analyze(text) {

  var probs = predictNB(MODEL, tokenize(text));

  var label = argmax(probs);

  return { label: label, prob: probs[label], probs: probs, uncertain: probs[label] < THRESHOLD };

}



// تدريب النموذج على البيانات الحالية

var MODEL = trainNB(DATA);

